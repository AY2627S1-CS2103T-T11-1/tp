@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam DefaultFontSize 16
skinparam ParticipantFontColor #FFFFFF
skinparam SequenceBoxFontColor #222222

box Logic #F2F2FC
    participant ":LogicManager" as logicManager LOGIC_COLOR
    participant ":AddressBookParser" as addressBookParser LOGIC_COLOR
    participant ":DeleteLessonCommandParser" as parser LOGIC_COLOR
    participant ":DeleteLessonCommand" as command LOGIC_COLOR
end box

box Model #FBF1F2
    participant ":Model" as model MODEL_COLOR
end box

[-> logicManager : execute("deletelesson 1 2")
activate logicManager

logicManager -> addressBookParser : parseCommand(...)
activate addressBookParser

create parser
addressBookParser -> parser : DeleteLessonCommandParser()
activate parser
parser --> addressBookParser
deactivate parser

addressBookParser -> parser : parse("1 2")
activate parser

create command
parser -> command : DeleteLessonCommand(...)
activate command
command --> parser
deactivate command

parser --> addressBookParser : command
deactivate parser
parser -[hidden]-> addressBookParser
destroy parser

addressBookParser --> logicManager : command
deactivate addressBookParser

logicManager -> command : execute(model)
activate command
command -> model : getFilteredPersonList()
activate model
model --> command : displayedStudents
deactivate model

command -> model : setPerson(...)
activate model
model --> command : return
deactivate model

note over command, model
  Only the selected lesson record is removed.
  The student, other lessons and
  active filter remain.
end note

command --> logicManager : commandResult
deactivate command
command -[hidden]-> logicManager
destroy command

[<-- logicManager : commandResult
deactivate logicManager
@enduml
