@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam DefaultFontSize 16
skinparam ParticipantFontColor #FFFFFF
skinparam SequenceBoxFontColor #222222

box Logic #F2F2FC
    participant ":LogicManager" as logicManager LOGIC_COLOR
    participant ":AddressBookParser" as addressBookParser LOGIC_COLOR
    participant "command:\nDeleteLessonCommand" as command LOGIC_COLOR
end box

box Model #FBF1F2
    participant "model:Model" as model MODEL_COLOR
end box

[-> logicManager : execute("deletelesson 1 2")
activate logicManager

logicManager -> addressBookParser : parseCommand("deletelesson 1 2")
activate addressBookParser
addressBookParser --> logicManager : command
deactivate addressBookParser

logicManager -> command : execute(model)
activate command
command -> model : getFilteredPersonList()
activate model
model --> command : displayedStudents
deactivate model

note right of command
  Displayed student 1 maps to filtered index 0.
  Select that student and get their lessons.
  Validate both indexes before changing the Model.
  Displayed lesson 2 maps to stored index
  lessons.size() - 2.
  Create updatedStudent using
  student.withLessonRemoved(storedIndex).

  Data-object calls are summarized here so this
  diagram exposes only Logic internals.
end note

command -> model : setPerson(student, updatedStudent)
activate model
model --> command : return
deactivate model

note right of model
  Replacing the student keeps the active filter.
  Only the selected occurrence is removed.
  Other lessons remain; deleting the final lesson
  leaves the student with an empty history.
end note

command --> logicManager : commandResult
deactivate command

note right of logicManager
  The subsequent save is shown in the
  architecture sequence diagram.
end note

[<-- logicManager : commandResult
deactivate logicManager
@enduml
