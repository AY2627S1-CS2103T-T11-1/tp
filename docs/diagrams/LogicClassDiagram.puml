@startuml
!include style.puml
skinparam arrowThickness 1.2
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR_T1
skinparam classBorderColor LOGIC_COLOR_T3
skinparam classFontColor #1E293B
skinparam classStereotypeFontColor #1E293B
skinparam classFontSize 17
skinparam ClassAttributeFontColor #1E293B
skinparam ClassAttributeFontSize 16
skinparam ClassAttributeIconSize 0
skinparam ArrowFontStyle plain
skinparam ArrowFontSize 15
skinparam nodesep 55
skinparam ranksep 65
skinparam Padding 5

package "Logic (partial)" {
    class "<<interface>>\nLogic" as Logic
    class LogicManager
    class AddressBookParser
    abstract class Command
    class LogCommand
    class ViewCommand
    class CommandResult {
        - feedbackToUser : String
        - showHelp : boolean
        - exit : boolean
        - student : Person [0..1]
    }
}
class "<<interface>>\nModel" as ModelApi MODEL_COLOR_T1
class "<<interface>>\nStorage" as StorageApi STORAGE_COLOR_T1

show fields
hide empty members

LogicManager .up.|> Logic
LogicManager -left-> "1" AddressBookParser
' Keep the end labels clear of the component border.
LogicManager -right-> "1  " ModelApi
LogicManager -right-> "1  " StorageApi
LogicManager .down.> Command : calls execute
AddressBookParser .down.> Command : returns

LogCommand -right-|> Command
ViewCommand -left-|> Command
Command ..> ModelApi
Command .down.> CommandResult : returns
@enduml
