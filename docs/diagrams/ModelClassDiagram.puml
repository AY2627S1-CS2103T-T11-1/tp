@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 16

package "Model (partial)" {
    class "<<interface>>\nModel" as Model
    class ModelManager
    class AddressBook
    class UniquePersonList

    class Person {
        + isSamePerson(otherPerson : Person) : boolean
        + withLessonAdded(lesson : Lesson) : Person
        + withLessonRemoved(zeroBasedIndex : int) : Person
    }

    class Name
    class Phone
    class Address
    class Level
    class Subject

    class Lesson {
        + content : String
        - date : LocalDate [0..1]
        + getDate() : Optional<LocalDate>
    }
}

show fields
show Person methods
show Lesson methods
hide empty members

ModelManager .up.|> Model
ModelManager -down-> "1" AddressBook
AddressBook *-down-> "1" UniquePersonList
UniquePersonList -down-> "0..*" Person : students
ModelManager -right-> "0..*" Person : filtered view

Person *-down-> "1" Name
Person *-down-> "1" Phone
Person *-down-> "1" Address
Person *-down-> "1" Level
Person *-down-> "1" Subject
Person *-down-> "0..*" Lesson : lessons
@enduml
