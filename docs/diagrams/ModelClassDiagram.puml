@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 16
skinparam linetype ortho

package "Model (partial)" {
    class "<<interface>>\nModel" as Model
    class ModelManager
    class AddressBook
    class UniquePersonList

    class Person {
        - name : Name
        - phone : Phone
        - address : Address
        - level : Level
        - subject : Subject
        - lessons : List<Lesson>
        + isSamePerson(other) : boolean
        + withLessonAdded(lesson) : Person
        + withLessonRemoved(index) : Person
    }

    class Name
    class Phone
    class Address
    class Level
    class Subject

    class Lesson {
        + content : String
        - date : LocalDate
        + getDate() : Optional<LocalDate>
    }
}

show fields
show Person methods
show Lesson methods
hide empty members

ModelManager .up.|> Model
ModelManager *-down-> "1" AddressBook
AddressBook *-down-> "1" UniquePersonList
UniquePersonList -down-> "0..*" Person : students
ModelManager -right-> "0..*" Person : filtered view

Person *-down-> "1" Name
Person *-down-> "1" Phone
Person *-down-> "1" Address
Person *-down-> "1" Level
Person *-down-> "1" Subject
Person *-down-> "0..*" Lesson : lessons

note right of Person
  A student's identity is the same phone
  and the same name, ignoring case.
  Commands that rebuild a Person carry
  its existing lessons across.
end note

note right of Lesson
  Immutable lesson value.
  date is absent for legacy v1.3 records.
  Stored order is oldest to newest.
end note
@enduml
