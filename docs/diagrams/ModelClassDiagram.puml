@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 16

package "Model (partial)" {
    class "<<interface>>\nModel" as Model
    class ModelManager
    class AddressBook
    class UniquePersonList

    class Person {
        + isSamePerson(otherPerson : Person) : boolean
        + withLessonAdded(lesson : Lesson) : Person
        + withLessonRemoved(zeroBasedIndex : int) : Person
        + withFlag(updatedFlag : Flag) : Person
        + withoutFlag() : Person
    }

    class Name
    class Phone
    class Address
    class Level
    class Subject

    class Flag {
        - reason : String [0..1]
        + getReason() : Optional<String>
    }

    class Lesson {
        + content : String
        - date : LocalDate [0..1]
        + getDate() : Optional<LocalDate>
    }
}

show fields
show Person methods
show Lesson methods
show Flag methods
hide empty members

ModelManager .up.|> Model
ModelManager -down-> "1\n" AddressBook
AddressBook *-down-> "1   " UniquePersonList
UniquePersonList -down-> "   internalList\n   0..*" Person
ModelManager -right-> "filteredPersons   \n0..*   " Person

Person *-down-> "1\n" Name
Person *-down-> "1\n" Phone
Person *-down-> "1\n" Address
Person *-down-> "1\n" Level
Person *-down-> "1\n" Subject
Person *-down-> "lessons\n0..*\n" Lesson
Person *-down-> "flag\n0..1\n" Flag
@enduml
