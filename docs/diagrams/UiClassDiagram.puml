@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam classFontSize 17
skinparam ClassAttributeFontColor #FFFFFF
skinparam ClassAttributeIconSize 0
skinparam ArrowFontSize 16
skinparam ArrowFontStyle plain
skinparam packageTitleAlignment left
skinparam Padding 15

package "UI (partial)" {
    class MainWindow
    class CommandBox {
        - commandExecutor : CommandExecutor
    }
    class ResultDisplay
    class PersonListPanel {
        - onPersonClick : Consumer<Index>
    }
    class PersonCard
}

package Logic {
    class "<<interface>>\nLogic" as LogicApi LOGIC_COLOR
}

package "Model (partial)" {
    class Person MODEL_COLOR
}

show fields
hide empty members

MainWindow -up-> "1" LogicApi
MainWindow -down-> "1" ResultDisplay
MainWindow .down.> CommandBox : <<create>>
MainWindow -down-> "1" PersonListPanel
PersonListPanel .down.> PersonCard : <<create>>
PersonCard -right-> "1" Person
@enduml
