@startuml
!include style.puml
skinparam arrowThickness 1.2
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR_T1
skinparam classBorderColor LOGIC_COLOR_T3
skinparam classFontColor #1E293B
skinparam classStereotypeFontColor #1E293B
skinparam classFontSize 17
skinparam ArrowFontStyle plain
skinparam ArrowFontSize 15
skinparam nodesep 45
skinparam ranksep 60
skinparam Padding 5

class AddressBookParser
class "<<interface>>\nParser" as Parser
class LogCommandParser
class DeleteLessonCommandParser
class LogCommand
class DeleteLessonCommand

AddressBookParser .down.> LogCommandParser : <<create>>
AddressBookParser .down.> DeleteLessonCommandParser : <<create>>
LogCommandParser .down.|> Parser
DeleteLessonCommandParser .down.|> Parser
LogCommandParser .down.> LogCommand : <<create>>
DeleteLessonCommandParser .down.> DeleteLessonCommand : <<create>>

' Keep the two command outputs outside the shared interface.
LogCommand -[hidden]right-> Parser
Parser -[hidden]right-> DeleteLessonCommand
@enduml
