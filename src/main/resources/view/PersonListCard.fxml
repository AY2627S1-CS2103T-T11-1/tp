<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="10" minWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="12" bottom="8" left="12" />
  </padding>
  <Label fx:id="id" styleClass="card-index">
    <minWidth>
      <!-- Ensures that the index stays readable when the name wraps -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <Label fx:id="avatar" styleClass="avatar" alignment="CENTER"
         minWidth="32" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" />
  <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
    <Label fx:id="name" styleClass="cell_big_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="levelSubject" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="lessonStatus" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
  </VBox>
  <SVGPath fx:id="flagIcon" styleClass="flag-icon" accessibleText="Flagged"
           content="M3 1h1.8v15H3z M4.8 1.5H14l-2.4 3.7L14 8.9H4.8z" />
</HBox>
