<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" fx:id="cardPane" alignment="TOP_LEFT" minWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="5" right="5" bottom="5" left="15" />
  </padding>
  <HBox spacing="0.5" alignment="TOP_LEFT">
    <Label fx:id="id" styleClass="cell_big_label">
      <minWidth>
        <!-- Ensures that the index stays readable when the name wraps -->
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <Label fx:id="name" text="\$first" styleClass="cell_big_label" HBox.hgrow="ALWAYS"
           wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="flaggedBadge" text="FLAGGED" styleClass="flagged-badge">
      <minWidth>
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
  </HBox>
  <Label fx:id="flagReason" styleClass="flag-reason" wrapText="true"
         minWidth="0" maxWidth="Infinity" />
  <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
  <Label fx:id="address" styleClass="cell_small_label" text="\$address"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
  <Label fx:id="level" styleClass="cell_small_label" text="\$level"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
  <Label fx:id="subject" styleClass="cell_small_label" text="\$subject"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
  <Label fx:id="lessonStatus" styleClass="cell_small_label"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
</VBox>
